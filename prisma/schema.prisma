generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceKind {
  SME
  BANK

  @@map("workspace_kind")
}

enum WorkspaceRole {
  OWNER
  OPERATOR
  VIEWER

  @@map("workspace_role")
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  issuer        String
  subject       String
  verifiedEmail String?      @map("verified_email")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions      Session[]
  memberships   Membership[]

  @@unique([issuer, subject])
  @@map("users")
}

model Session {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique
  kind        WorkspaceKind       @default(SME)
  displayName String              @map("display_name")
  sector      String?
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz(3)
  memberships Membership[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  idempotency IdempotencyRecord[]
  customers   Customer[]

  invoices       Invoice[]
  invoiceCounter InvoiceCounter?

  expenses Expense[]

  @@map("workspaces")
}

model Membership {
  tenantId  String        @map("tenant_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  workspace Workspace     @relation(fields: [tenantId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  role      WorkspaceRole
  version   Int           @default(1)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime?     @map("revoked_at") @db.Timestamptz(3)

  @@id([tenantId, userId])
  @@index([userId, tenantId])
  @@map("memberships")
}

model IdempotencyRecord {
  scope       String
  key         String
  requestHash String     @map("request_hash")
  actorId     String     @map("actor_id") @db.Uuid
  tenantId    String?    @map("tenant_id") @db.Uuid
  workspace   Workspace? @relation(fields: [tenantId], references: [id])
  outcome     Json
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditEvent {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  workspace  Workspace @relation(fields: [tenantId], references: [id])
  actorId    String    @map("actor_id") @db.Uuid
  action     String
  resourceId String    @map("resource_id") @db.Uuid
  version    Int?
  requestId  String    @map("request_id") @db.Uuid
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt, id])
  @@map("audit_events")
}

model Invitation {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  workspace    Workspace     @relation(fields: [tenantId], references: [id])
  email        String
  role         WorkspaceRole
  tokenHash    String        @unique @map("token_hash")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  redeemedAt   DateTime?     @map("redeemed_at") @db.Timestamptz(3)
  supersededAt DateTime?     @map("superseded_at") @db.Timestamptz(3)

  @@index([tenantId, email])
  @@map("invitations")
}

model Customer {
  tenantId    String    @map("tenant_id") @db.Uuid
  id          String    @default(uuid()) @db.Uuid
  workspace   Workspace @relation(fields: [tenantId], references: [id])
  displayName String    @map("display_name")
  email       String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invoices Invoice[]

  @@id([tenantId, id])
  @@index([tenantId, displayName, id])
  @@map("customers")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID

  @@map("invoice_status")
}

model Invoice {
  tenantId         String        @map("tenant_id") @db.Uuid
  id               String        @default(uuid()) @db.Uuid
  workspace        Workspace     @relation(fields: [tenantId], references: [id])
  customerId       String        @map("customer_id") @db.Uuid
  customer         Customer      @relation(fields: [tenantId, customerId], references: [tenantId, id])
  customerSnapshot Json?         @map("customer_snapshot")
  issueDate        DateTime      @map("issue_date") @db.Date
  dueDate          DateTime      @map("due_date") @db.Date
  status           InvoiceStatus @default(DRAFT)
  totalKobo        BigInt        @map("total_kobo")
  issuedNumber     BigInt?       @map("issued_number")
  issuedAt         DateTime?     @map("issued_at") @db.Timestamptz(3)
  voidReason       String?       @map("void_reason")
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(3)
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lines            InvoiceLine[]

  settledKobo BigInt       @default(0) @map("settled_kobo")
  settlements Settlement[]

  @@id([tenantId, id])
  @@unique([tenantId, issuedNumber])
  @@index([tenantId, status, dueDate, id])
  @@index([tenantId, issueDate, id])
  @@map("invoices")
}

model InvoiceLine {
  tenantId    String  @map("tenant_id") @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  invoice     Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  position    Int
  description String
  quantity    Int
  unitKobo    BigInt  @map("unit_kobo")

  @@id([tenantId, invoiceId, position])
  @@map("invoice_lines")
}

model InvoiceCounter {
  tenantId   String    @id @map("tenant_id") @db.Uuid
  workspace  Workspace @relation(fields: [tenantId], references: [id])
  lastNumber BigInt    @map("last_number")

  @@map("invoice_counters")
}

enum ExpenseCategory {
  SUPPLIES
  RENT_AND_UTILITIES
  TRANSPORT
  PAYROLL
  FEES
  OTHER

  @@map("expense_category")
}

enum ExpenseStatus {
  ACTIVE
  VOID

  @@map("expense_status")
}

model Expense {
  tenantId    String          @map("tenant_id") @db.Uuid
  id          String          @default(uuid()) @db.Uuid
  workspace   Workspace       @relation(fields: [tenantId], references: [id])
  expenseDate DateTime        @map("expense_date") @db.Date
  payee       String
  category    ExpenseCategory
  reference   String?
  amountKobo  BigInt          @map("amount_kobo")
  status      ExpenseStatus   @default(ACTIVE)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt    DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidReason  String?         @map("void_reason")

  @@id([tenantId, id])
  @@index([tenantId, expenseDate, id])
  @@map("expenses")
}

enum SettlementSource {
  MANUAL
  STATEMENT

  @@map("settlement_source")
}

model Settlement {
  tenantId       String           @map("tenant_id") @db.Uuid
  id             String           @default(uuid()) @db.Uuid
  invoiceId      String           @map("invoice_id") @db.Uuid
  invoice        Invoice          @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  source         SettlementSource
  receiptDate    DateTime         @map("receipt_date") @db.Date
  amountKobo     BigInt           @map("amount_kobo")
  reference      String?
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  reversedAt     DateTime?        @map("reversed_at") @db.Timestamptz(3)
  reversedBy     String?          @map("reversed_by") @db.Uuid
  reversalId     String?          @map("reversal_id") @db.Uuid
  reversalReason String?          @map("reversal_reason")

  @@id([tenantId, id])
  @@unique([tenantId, reversalId])
  @@index([tenantId, invoiceId, receiptDate, id])
  @@map("settlements")
}

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://finbridge_app:finbridge_local_app@127.0.0.1:55432/finbridge?schema=public
DIRECT_URL=postgresql://finbridge_migrate:finbridge_local_migrate@127.0.0.1:55432/finbridge?schema=public

LOCAL_AUTH_ENABLED=true
INVITATION_SECRET=finbridge_local_invitation_secret_do_not_deploy

# Optional managed OIDC. Set all four values to enable.

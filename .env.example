NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://finbridge_app:finbridge_local_app@127.0.0.1:55432/finbridge?schema=public
DIRECT_URL=postgresql://finbridge_migrate:finbridge_local_migrate@127.0.0.1:55432/finbridge?schema=public

LOCAL_AUTH_ENABLED=true
INVITATION_SECRET=finbridge_local_invitation_secret_do_not_deploy

# Optional managed OIDC. Set all four values to enable.
# OIDC_ISSUER=https://identity.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_FLOW_SECRET=

WORKER_DATABASE_URL=postgresql://finbridge_worker:finbridge_local_worker@127.0.0.1:55432/finbridge?schema=public
REDIS_URL=redis://127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
S3_BUCKET=finbridge-local
S3_REGION=us-east-1
S3_ACCESS_KEY=S3RVER
S3_SECRET_KEY=S3RVER
UPLOAD_TICKET_SECRET=finbridge_local_upload_ticket_secret_do_not_deploy

REQUEST_LOG_ENABLED=true

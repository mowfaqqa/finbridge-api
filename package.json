{
  "name": "finbridge-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch -r ts-node/register src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "api:export": "node --env-file-if-exists=.env dist/export-openapi.js",
    "test:integration": "node --env-file-if-exists=.env --test test/*.test.cjs",
    "worker:dev": "node --env-file-if-exists=.env --watch -r ts-node/register src/worker.ts",
    "worker:start": "node --env-file-if-exists=.env dist/worker.js",
    "storage:dev": "node --env-file-if-exists=.env infra/local-storage.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "~6.19.0",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0",
    "openid-client": "^6.8.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "bullmq": "^5.65.0",
    "csv-parse": "^6.1.0",
    "pdfkit": "^0.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "~6.19.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0",
    "s3rver": "^3.7.0",
    "@types/pdfkit": "^0.17.0"
  }
}
